# Server Configuration (Railway automatically sets PORT dynamically; in local dev default is 5000)
PORT=5000
NODE_ENV=production

# Database Connection (Provide either MONGODB_URI or MONGO_URL)
# For MongoDB Atlas:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/dbname?retryWrites=true&w=majority
# Or if using Railway's one-click MongoDB service, it automatically provides MONGO_URL

# Razorpay Credentials (from https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_live_YourRazorpayKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpayKeySecretHere

# Frontend URL(s) for CORS (allow requests from your deployed portfolio)
# Can be a single URL or comma-separated list (e.g. https://yourportfolio.vercel.app,http://localhost:5173)
FRONTEND_URL=https://your-portfolio-domain.com

# JWT Secret for signing auth tokens (generate a long random string)
JWT_SECRET=your_jwt_secret_key_here
